# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI cache
supabase/.temp/
supabase/.branches/
# Supabase CLI scratch when the CLI is run from inside a function dir
# (creates a nested supabase/.temp there rather than at the repo root).
**/.temp/
supabase/functions/*/supabase/

# QA harness run artifacts (preserve placeholder .gitkeep + README only)
qa/*/artifacts/*
!qa/*/artifacts/.gitkeep

# KAN-124 AC-12 pattern secrecy — taxonomy patterns are SEC-stamped content
# and never touch the public repo. The FLAG_TAXONOMY Supabase Edge Function
# secret holds them; this local file is the operator's dashboard input only.
flag_taxonomy_secret.json

# Local Netlify folder
.netlify

# AI-tooling scratch (never commit)
.playwright-mcp/
.claude/worktrees/

# Audit sim screenshots — local-only (public repo; capture test-account states)
docs/audits/2026-07-03-compliance-a11y-store-audit/sim-screens/
