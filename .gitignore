# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI cache
supabase/.temp/
supabase/.branches/

# QA harness run artifacts (preserve placeholder .gitkeep + README only)
qa/*/artifacts/*
!qa/*/artifacts/.gitkeep

# KAN-124 AC-12 pattern secrecy — taxonomy patterns are SEC-stamped content
# and never touch the public repo. The FLAG_TAXONOMY Supabase Edge Function
# secret holds them; this local file is the operator's dashboard input only.
flag_taxonomy_secret.json
