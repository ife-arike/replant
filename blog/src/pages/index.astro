---
import Base from '../layouts/Base.astro'
import PostCard from '../components/PostCard.astro'
import { getCollection } from 'astro:content'

const all = await getCollection('posts', ({ data }) => {
  return import.meta.env.DEV ? true : data.draft !== true
})

const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Base
  title="Replant · Blog"
  description="A quiet reading room from Replant. Letters, scripture, and field reports from the persecuted church."
>
  <section class="hero">
    <span class="eyebrow">A reading room</span>
    <h1>From the <em>persecuted</em> church<br />to the watching one.</h1>
    <p class="subline">Sporadic letters, scripture, and field reports. No noise.</p>
  </section>

  <section class="list">
    {posts.length === 0 ? (
      <p class="empty">No posts yet. The first letter is coming.</p>
    ) : (
      posts.map((p) => (
        <PostCard
          href={`/posts/${p.id.replace(/\.(md|mdx)$/, '')}`}
          title={p.data.title}
          eyebrow={p.data.eyebrow}
          date={p.data.date}
          author={p.data.author}
          summary={p.data.summary}
        />
      ))
    )}
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 7rem 2rem 4rem;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse 55% 45% at 50% 35%, rgba(107, 181, 232, 0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero .eyebrow {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 1.1rem;
    max-width: 16ch;
    margin-inline: auto;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--sky);
  }
  .subline {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1rem, 2.3vw, 1.3rem);
    color: var(--ink-mid);
    max-width: 38ch;
    margin: 0 auto;
  }

  .list {
    max-width: 70ch;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
    border-top: 0.5px solid var(--ink-faint);
  }

  .empty {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-mid);
    text-align: center;
    padding: 4rem 0;
    font-size: 1.1rem;
  }
</style>
