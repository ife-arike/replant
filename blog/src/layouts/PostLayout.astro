---
import Base from './Base.astro'
import '../styles/prose.css'

interface Props {
  title: string
  eyebrow?: string
  date: Date
  author: string
  summary: string
  ogImage?: string
}

const { title, eyebrow, date, author, summary, ogImage } = Astro.props
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const iso = date.toISOString()
---

<Base title={`${title.replace(/<\/?em>/g, '')} · Replant`} description={summary} ogImage={ogImage}>
  <article>
    <header class="post-header">
      {eyebrow ? <span class="eyebrow">{eyebrow}</span> : null}
      <h1 class="post-title" set:html={title} />
      <p class="meta">
        <span>By {author}</span>
        <span class="dot">·</span>
        <time datetime={iso}>{formatted}</time>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  article {
    padding: 4.5rem 1.5rem 6rem;
  }
  .post-header {
    max-width: 68ch;
    margin: 0 auto 3.5rem;
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 1.4rem;
  }
  .post-title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.12;
    color: var(--ink);
    margin-bottom: 1.4rem;
    letter-spacing: -0.01em;
  }
  .post-title :global(em) {
    font-style: italic;
    color: var(--sky);
  }
  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: var(--ink-mid);
    text-transform: uppercase;
  }
  .meta .dot { color: var(--ink-faint); }
</style>
